# Directly By Developers - Hostinger SMTP Backend Environment Configuration
# Copy this file to api/.env or set these in your server environment if using env variables

APP_ENV=production
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_ENCRYPTION=ssl
SMTP_USERNAME=connect@directlybydevelopers.com
SMTP_PASSWORD=YOUR_HOSTINGER_EMAIL_PASSWORD_HERE
SMTP_FROM_EMAIL=connect@directlybydevelopers.com
SMTP_FROM_NAME="Directly By Developers Lead Desk"
SMTP_TO_EMAIL=connect@directlybydevelopers.com
