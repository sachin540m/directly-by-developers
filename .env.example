# Directly By Developers - Frontend Environment Variables (Example)
# In development (localhost):
# VITE_LEAD_API_URL=http://localhost:8000/backend/api/submit-lead.php

# In production (Hostinger deployment):
# If deployed on the same domain as the backend:
VITE_LEAD_API_URL=/api/submit-lead.php

# If backend is hosted under a specific subdomain or path:
# VITE_LEAD_API_URL=https://directlybydevelopers.com/api/submit-lead.php
